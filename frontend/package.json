{
  "name": "port-management-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
