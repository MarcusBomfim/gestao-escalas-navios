{
  "Jwt": {
    "Issuer": "PortManagement.Api",
    "Audience": "PortManagement.Web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Resilience": {
    "RequestTimeoutSeconds": 30,
    "ShutdownTimeoutSeconds": 30,
    "Database": {
      "CommandTimeoutSeconds": 30,
      "MaxRetryCount": 3,
      "MaxRetryDelaySeconds": 5
    }
  },
  "PasswordRecovery": {
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "EnableSsl": false,
    "FromAddress": "no-reply@portmanagement.local",
    "FromName": "Port Management",
    "PublicWebUrl": "http://localhost:5173",
    "TokenLifetimeMinutes": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
