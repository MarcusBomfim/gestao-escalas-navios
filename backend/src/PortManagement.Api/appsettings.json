{
  "Jwt": {
    "Issuer": "PortManagement.Api",
    "Audience": "PortManagement.Web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Resilience": {
    "RequestTimeoutSeconds": 30,
    "ShutdownTimeoutSeconds": 30,
    "Database": {
      "CommandTimeoutSeconds": 30,
      "MaxRetryCount": 3,
      "MaxRetryDelaySeconds": 5
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
